        const gallery = document.getElementById('gallery');
        const searchInput = document.getElementById('searchInput');
        const status = document.getElementById('movieStatus');
        const player = document.getElementById('playerView');
        const iframe = document.getElementById('portalIframe');
        const loader = document.getElementById('streamLoader');
        const nowPlaying = document.getElementById('nowPlaying');

        function render(data) {
            gallery.innerHTML = '';
            data.forEach(m => {
                const card = document.createElement('div');
                card.className = 'movie-card group cursor-pointer overflow-hidden flex flex-col';
                card.onclick = () => openPortal(m);
                card.innerHTML = `
                    <div class="aspect-[2/3] overflow-hidden relative">
                        <img src="${m.img}" alt="${m.title}" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[4px]">
                            <div class="bg-black text-white rounded-full p-6 scale-75 group-hover:scale-100 transition-transform duration-500">
                                <svg width="24" height="24" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"></path></svg>
                            </div>
                        </div>
                    </div>
                    <div class="p-10 flex-grow">
                        <div class="text-[10px] font-black text-[--baby-blue] mb-4 tracking-[0.3em] uppercase">${m.yr} Portal</div>
                        <h3 class="brand-font text-2xl mb-4 leading-none uppercase group-hover:text-[--baby-blue] transition-colors">${m.title}</h3>
                    </div>
                `;
                gallery.appendChild(card);
            });
            status.innerText = `PORTAL STATUS: ${data.length} MOVIES SYNCED`;
        }

        function openPortal(m) {
            player.classList.add('active');
            nowPlaying.innerText = m.title;
            loader.style.display = 'flex';
            iframe.src = m.url;
            iframe.onload = () => { loader.style.display = 'none'; };
            document.body.style.overflow = 'hidden';
        }

        function closePlayer() {
            player.classList.remove('active');
            iframe.src = '';
            document.body.style.overflow = 'auto';
            document.getElementById('streamWrap').classList.remove('mock-fs');
        }

        function toggleMockFS() {
            document.getElementById('streamWrap').classList.toggle('mock-fs');
        }

        searchInput.oninput = (e) => {
            const val = e.target.value.toLowerCase();
            const filtered = movieDB.filter(m => m.title.toLowerCase().includes(val));
            render(filtered);
        };

        render(movieDB);

